{
  "name": "sparrow-ddd",
  "version": "0.6.0",
  "description": "Sparrow — spec-driven DDD framework for AI coding assistants. Generate structured skills that guide AI agents through domain-driven design, from business requirements to production code.",
  "type": "module",
  "bin": {
    "sparrow": "./bin/sparrow.js"
  },
  "files": [
    "bin/",
    "dist/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node build.js",
    "dev": "node --import ./scripts/register-assets.mjs --import tsx src/cli/index.ts",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit",
    "sync-schema": "node scripts/sync-schema-json.mjs && node scripts/generate-sparrow-state-mjs.mjs && node scripts/generate-sparrow-promote-mjs.mjs && node scripts/sync-bundled-content.mjs",
    "test": "node --import ./scripts/register-assets.mjs --import tsx --test 'test/**/*.test.ts'"
  },
  "keywords": [
    "ddd",
    "domain-driven-design",
    "spec-driven-development",
    "ai-coding",
    "claude-code",
    "opencode",
    "cursor",
    "architecture",
    "code-generation"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/agiledon/sparrow"
  },
  "homepage": "https://github.com/agiledon/sparrow",
  "bugs": {
    "url": "https://github.com/agiledon/sparrow/issues"
  },
  "author": "agiledon",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.0.0",
    "commander": "^13.1.0",
    "js-yaml": "^4.1.0",
    "mammoth": "^1.12.3",
    "tesseract.js": "^7.0.0",
    "unpdf": "^1.8.1",
    "word-extractor": "^1.0.4"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
